<Window x:Class="seriel_number_generator.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Antal serienumre" Height="170" Width="320"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="Hvor mange serienumre vil du oprette?" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <TextBox x:Name="TxtCount" Text="1" Height="28" VerticalContentAlignment="Center" Margin="0,0,0,14"/>
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuller" Width="75" Height="26" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="OK" Width="75" Height="26" IsDefault="True" Click="BtnOk_Click" 
                    Background="#2563EB" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </StackPanel>
</Window>