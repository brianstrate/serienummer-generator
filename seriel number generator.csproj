<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>

    <!-- MinVer konfiguration -->
    <!-- Fortæller MinVer, at tags starter med 'v' (f.eks. v1.4.0) -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <!-- Standardversion hvis der endnu ikke findes noget tag i repoet -->
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="all" />
    <PackageReference Include="SkiaSharp" Version="4.154.0" />
    <PackageReference Include="Svg.Skia" Version="5.2.3" />
  </ItemGroup>

</Project>