<Window x:Class="seriel_number_generator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Serienummer og Vaskemærker Generator  -  RestfulBlanket" Height="780" Width="1040"
        WindowStartupLocation="CenterScreen"
        Icon="app.ico">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Filer">
                <MenuItem Header="_Afslut" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="_Hjælp">
                <MenuItem Header="_Skabelon Variabler..." Click="MenuTemplateHelp_Click"/>
                <MenuItem Header="Søg efter opdateringer..." Click="MenuCheckUpdate_Click"/>
                <Separator/>
                <MenuItem Header="_Om" Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <TabControl Margin="8">
            <!-- FANE 1: GENERER SERIENUMMER & VEKTOR -->
            <TabItem Header="Generér Serienummer &amp; Vektor">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Vælg parametre til nyt serienummer" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

                        <!-- Årstal og Måned -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <Label Content="Årstal (YYYY):" FontWeight="SemiBold"/>
                                <TextBox x:Name="TxtYear" Height="28" VerticalContentAlignment="Center" MaxLength="4"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <Label Content="Måned:" FontWeight="SemiBold"/>
                                <ComboBox x:Name="CmbMonth" Height="28" DisplayMemberPath="Name" SelectedValuePath="Value"/>
                            </StackPanel>
                        </Grid>

                        <Label Content="Standard:" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CmbStandard" DisplayMemberPath="Name" SelectedValuePath="Id" Height="28"/>

                        <Label Content="UDI:" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <ComboBox x:Name="CmbUdi" DisplayMemberPath="Udi" SelectedValuePath="Id" Height="28"/>

                        <Label Content="REF:" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <ComboBox x:Name="CmbRef" DisplayMemberPath="Ref" SelectedValuePath="Id" Height="28"/>

                        <Label Content="Raps Batch:" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <ComboBox x:Name="CmbRaps" DisplayMemberPath="Batch" SelectedValuePath="Id" Height="28"/>

                        <Label Content="Tekstil Batch:" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <ComboBox x:Name="CmbTextile" DisplayMemberPath="Batch" SelectedValuePath="Id" Height="28"/>

                        <Label Content="Vasketemperatur:" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <ComboBox x:Name="CmbWashTemp" DisplayMemberPath="Temp" SelectedValuePath="Id" Height="28"/>

                        <Label Content="Skabelon (Vektor Template):" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <ComboBox x:Name="CmbTemplate" DisplayMemberPath="TemplateFile" SelectedValuePath="Id" Height="28"/>

                        <Label Content="Note (valgfri):" Margin="0,6,0,0"/>
                        <TextBox x:Name="TxtSerialNote" Height="26"/>

                        <Button x:Name="BtnGenerate" Content="Generér &amp; Opret Vektorfil" 
                                Height="40" Margin="0,16,0,0" FontWeight="Bold" Background="#2563EB" Foreground="White"
                                Click="BtnGenerate_Click" Cursor="Hand"/>
                    </StackPanel>

                    <DockPanel Grid.Column="1">
                        <TextBlock DockPanel.Dock="Top" Text="Seneste genererede data:" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                        <ListBox x:Name="LstSerials" FontFamily="Consolas" FontSize="12"/>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- FANE 2: ADMINISTRER & RET SERIENUMRE -->
            <TabItem Header="Administrer Serienumre">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1.2*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Oversigt over registrerede serienumre" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button x:Name="BtnExportCsv" Content="Eksportér til CSV" Width="140" Height="28" 
                                HorizontalAlignment="Right" Click="BtnExportCsv_Click" Cursor="Hand"
                                Background="#2563EB" Foreground="White" FontWeight="SemiBold"/>
                    </DockPanel>

                    <DataGrid x:Name="GridSerials" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" 
                              SelectionMode="Single" SelectionChanged="GridSerials_SelectionChanged" Margin="0,0,0,10"/>

                    <GroupBox Grid.Row="2" Header="Rediger valgt serienummer" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Label Content="Serienummer:" FontWeight="Bold" Width="100"/>
                                    <TextBox x:Name="TxtEditSerialNum" Width="160" Height="26" IsReadOnly="True" Background="#F3F4F6"/>
                                    <CheckBox x:Name="ChkEditSerialActive" Content="Aktiv" VerticalAlignment="Center" Margin="16,0,0,0" IsChecked="True"/>
                                </StackPanel>

                                <Label Content="Standard:"/>
                                <ComboBox x:Name="CmbEditStandard" DisplayMemberPath="Name" SelectedValuePath="Id" Height="26"/>

                                <Label Content="UDI:" Margin="0,4,0,0"/>
                                <ComboBox x:Name="CmbEditUdi" DisplayMemberPath="Udi" SelectedValuePath="Id" Height="26"/>

                                <Label Content="REF:" Margin="0,4,0,0"/>
                                <ComboBox x:Name="CmbEditRef" DisplayMemberPath="Ref" SelectedValuePath="Id" Height="26"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <Label Content="Raps Batch:"/>
                                <ComboBox x:Name="CmbEditRaps" DisplayMemberPath="Batch" SelectedValuePath="Id" Height="26"/>

                                <Label Content="Tekstil Batch:" Margin="0,4,0,0"/>
                                <ComboBox x:Name="CmbEditTextile" DisplayMemberPath="Batch" SelectedValuePath="Id" Height="26"/>

                                <Label Content="Vasketemperatur:" Margin="0,4,0,0"/>
                                <ComboBox x:Name="CmbEditWashTemp" DisplayMemberPath="Temp" SelectedValuePath="Id" Height="26"/>

                                <Label Content="Skabelon:" Margin="0,4,0,0"/>
                                <ComboBox x:Name="CmbEditTemplate" DisplayMemberPath="TemplateFile" SelectedValuePath="Id" Height="26"/>

                                <Label Content="Note:" Margin="0,4,0,0"/>
                                <TextBox x:Name="TxtEditSerialNote" Height="26"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                    <Button Content="Gendan Vektorfil" Width="130" Height="30" Margin="0,0,8,0" Click="BtnRegenerateVector_Click" Cursor="Hand"/>
                                    <Button Content="Gem Ændringer" Width="120" Height="30" Background="#16A34A" Foreground="White" FontWeight="Bold" Click="BtnUpdateSerial_Click" Cursor="Hand"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- FANE 3: STAMDATA & RETTIGELSER -->
            <TabItem Header="Stamdata Indstillinger">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Label Content="Vælg tabel til administration:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CmbTableSelect" Width="200" Height="28" Margin="8,0,0,0" 
                                  SelectionChanged="CmbTableSelect_SelectionChanged"/>
                    </StackPanel>

                    <GroupBox Grid.Row="1" x:Name="GrpStamdataEdit" Header="Opret / Rediger post i valgt tabel" Padding="10" Margin="0,0,0,12">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Label Content="ID:" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtRecordId" Width="50" Height="26" Margin="4,0,10,0" IsReadOnly="True" Background="#F3F4F6"/>

                            <Label Content="Værdi/Navn/Sti:" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtNewValue" Width="220" Height="26" Margin="4,0,6,0"/>

                            <Button x:Name="BtnBrowseTemplate" Content="Gennemse..." Width="85" Height="26" 
                                    Margin="0,0,10,0" Click="BtnBrowseTemplate_Click" Visibility="Collapsed" Cursor="Hand"/>

                            <Button x:Name="BtnBrowseFolder" Content="Vælg mappe..." Width="95" Height="26" 
                                    Margin="0,0,10,0" Click="BtnBrowseFolder_Click" Visibility="Collapsed" Cursor="Hand"/>

                            <Label Content="Note:" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtNewNote" Width="170" Height="26" Margin="4,0,10,0"/>

                            <CheckBox x:Name="ChkRecordActive" Content="Aktiv" VerticalAlignment="Center" Margin="0,0,12,0" IsChecked="True"/>

                            <Button x:Name="BtnSaveRecord" Content="Gem ændring" Width="95" Height="28" Margin="0,0,6,0" 
                                    Background="#16A34A" Foreground="White" FontWeight="Bold" Click="BtnSaveRecord_Click" Cursor="Hand"/>
                            <Button x:Name="BtnCancelEdit" Content="Nulstil" Width="70" Height="28" Click="BtnCancelEdit_Click" Cursor="Hand"/>
                        </WrapPanel>
                    </GroupBox>

                    <DataGrid x:Name="GridRecords" Grid.Row="2" AutoGenerateColumns="True" IsReadOnly="True" 
                              SelectionMode="Single" SelectionChanged="GridRecords_SelectionChanged"/>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>